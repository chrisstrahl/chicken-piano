{
  // Type checking only: esbuild (build.mjs) does the actual build and strips the types.
  // .ts files are checked strictly; .js files are allowed but not checked, so modules can move
  // to TypeScript one at a time. Run: npm run typecheck
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
